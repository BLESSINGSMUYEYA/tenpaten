generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  emailVerified       DateTime?
  passwordHash        String
  fullName            String
  role                Role
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  personalInfo        Json?
  academicInfo        Json?
  familyInfo          Json?
  activitiesInfo      Json?
  financialInfo       Json?
  workExperience      Json?
  documents           Json?
  profilePhoto        String?
  managedUniversityId String?
  affiliateProfile    AffiliateProfile?
  applications        Application[]
  actionsPerformed    AuditLog[]
  conversations       ConversationParticipant[]
  managedCountry      Country?                  @relation("CountryDirector")
  residenceCountry    Country?                  @relation("CountryResidents", fields: [residenceCountryId], references: [id])
  residenceCountryId  String?
  messagesSent        Message[]
  notifications       Notification[]
  managedUniversity   University?               @relation("UniversityAdmin", fields: [managedUniversityId], references: [id])
  status              UserStatus                @default(ACTIVE)
  transactions        InstitutionalTransaction[]
}

model Country {
  id             String             @id @default(cuid())
  name           String             @unique
  code           String             @unique
  directorId     String?            @unique
  currencySymbol String             @default("₹")
  director       User?              @relation("CountryDirector", fields: [directorId], references: [id])
  universities   University[]
  affiliates     AffiliateProfile[]
  residents      User[]             @relation("CountryResidents")
}

model QuestionnaireQuestion {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  type        String   @default("select")
  category    String   @default("PROSPECT")
  placeholder String?
  options     Json?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model University {
  id                      String             @id @default(cuid())
  name                    String
  countryId               String
  description             String?
  images                  String[]
  logo                    String?
  website                 String?
  applicationRequirements Json?
  settings                Json?
  applicationOpenDate     DateTime?
  applicationCloseDate    DateTime?
  createdAt               DateTime           @default(now())
  tuition                 String?
  globalScholarshipActive Boolean            @default(false)
  globalScholarshipPercentage Float?
  status                  UniversityStatus   @default(PENDING)
  phone                   String?
  rejectionReason         String?
  applicationFeeAmount    Float?
  applicationFeeCurrency  String             @default("MWK")
  bankName                String?
  accountNumber           String?
  accountName             String?
  mobileMoneyNumber       String?
  affiliates              AffiliateProfile[]
  departments             Department[]
  programs                Program[]
  country                 Country            @relation(fields: [countryId], references: [id])
  admins                  User[]             @relation("UniversityAdmin")
  transactions            InstitutionalTransaction[]
  payouts                 Payout[]
}

model Department {
  id           String     @id @default(cuid())
  name         String
  universityId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id])
  programs     Program[]
}

model Program {
  id           String        @id @default(cuid())
  name         String
  description  String?
  duration              String?
  baseTuition           Float?
  scholarshipPercentage Float?
  excludeFromGlobalScholarship Boolean @default(false)
  level                 String?
  requirements String?
  intake       String?
  universityId String
  departmentId          String?
  majors                String[]
  subjectRequirements   Json?
  applications          Application[]
  alternativeApplications Application[] @relation("AlternativeProgram")
  department            Department?   @relation(fields: [departmentId], references: [id])
  university            University    @relation(fields: [universityId], references: [id])

  @@index([universityId, level])
}

model AffiliateProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  universityId   String?
  countryId      String?
  referralCode   String          @unique
  status         AffiliateStatus @default(PENDING)
  rewardType     RewardType      @default(CASH)
  commissionRate Float           @default(10.0)
  bankDetails    Json?
  approvedBy     String?
  country        Country?        @relation(fields: [countryId], references: [id])
  university     University?     @relation(fields: [universityId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  referrals      Application[]
  transactions   InstitutionalTransaction[]
  payouts        AffiliatePayout[]

  @@index([countryId, status])
}

model Application {
  id                   String                     @id @default(cuid())
  prospectId           String
  programId            String
  status               ApplicationStatus          @default(DRAFT)
  affiliateId          String?
  personalInfo         Json?
  academicInfo         Json?
  familyInfo           Json?
  activitiesInfo       Json?
  financialInfo        Json?
  workExperience       Json?
  documents            Json?
  offerLetterUrl       String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  expiresAt            DateTime?
  reviewData           Json?
  acceptanceLetterUrl  String?
  enrollmentDetailsUrl String?

  alternativeProgramId String?
  alternativeStatus    AlternativeStatus?
  alternativeProgram   Program?                   @relation("AlternativeProgram", fields: [alternativeProgramId], references: [id])

  affiliate            AffiliateProfile?          @relation(fields: [affiliateId], references: [id])
  program              Program                    @relation(fields: [programId], references: [id])
  prospect             User                       @relation(fields: [prospectId], references: [id])
  statusHistory        ApplicationStatusHistory[]
  transactions         InstitutionalTransaction[]

  @@index([prospectId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  changedBy     String
  note          String?
  createdAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

enum Role {
  SUPER_ADMIN
  COUNTRY_DIRECTOR
  SCHOOL_ADMIN
  AFFILIATE
  PROSPECT
}

enum ApplicationStatus {
  DRAFT
  PAYMENT_PENDING
  SUBMITTED
  COUNTRY_REVIEW
  UNIVERSITY_REVIEW
  OFFER_ISSUED
  OFFER_ACCEPTED
  ENROLLED
  REJECTED
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardType {
  CASH
  TUITION_DISCOUNT
}

enum UniversityStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AlternativeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model InstitutionalTransaction {
  id                String            @id @default(cuid())
  userId            String            // Student who paid
  universityId      String?           // School who receives funds
  applicationId     String?           // Which application this is for
  
  // Financial Breakdown
  totalAmount       Float             // The total the student paid
  platformFee       Float             // Our cut
  schoolAmount      Float             // What the school gets
  affiliateAmount   Float             @default(0) // What the affiliate gets (if any)
  currency          String            @default("MWK")
  
  status            TransactionStatus @default(PENDING)
  type              TransactionType   @default(APPLICATION_FEE)
  
  referenceId       String            @unique 
  gatewayReference  String?           
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id])
  university        University?       @relation(fields: [universityId], references: [id])
  application       Application?      @relation(fields: [applicationId], references: [id])
  affiliate         AffiliateProfile? @relation(fields: [affiliateId], references: [id])
  affiliateId       String?
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  APPLICATION_FEE
  TUITION_DEPOSIT
  PLATFORM_SUBSCRIPTION
}

model Payout {
  id            String       @id @default(cuid())
  universityId  String
  amount        Float
  currency      String       @default("MWK")
  status        PayoutStatus @default(PENDING)
  method        String?      // Optional override of university default
  
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  
  receiptUrl    String?      // Proof of payment
  adminNotes    String?      // Internal notes from super admin
  
  university    University   @relation(fields: [universityId], references: [id])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model AffiliatePayout {
  id                String                 @id @default(cuid())
  affiliateId       String
  amount            Float
  currency          String                 @default("MWK")
  status            AffiliatePayoutStatus  @default(PENDING)
  requestedAt       DateTime               @default(now())
  processedAt       DateTime?
  receiptUrl        String?
  adminNotes        String?
  
  affiliate         AffiliateProfile      @relation(fields: [affiliateId], references: [id])
}

enum AffiliatePayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}
